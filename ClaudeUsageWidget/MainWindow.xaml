<Window x:Class="ClaudeUsageWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Usage"
        Width="260"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        MouseLeftButtonDown="OnDragWindow">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="UsageBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="3" Background="#26FFFFFF" />
                            <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#99FFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Card"
            CornerRadius="10"
            Background="#EB1C1C21"
            BorderBrush="#30FFFFFF"
            BorderThickness="1"
            Padding="14,8,10,10"
            Margin="6"
            ToolTip="{Binding BreakdownTooltip}"
            ToolTipService.InitialShowDelay="900">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.45" />
        </Border.Effect>

        <Border.ContextMenu>
            <ContextMenu Opened="OnMenuOpened">
                <MenuItem Header="Refresh now" Click="OnRefreshClick" />
                <Separator />
                <MenuItem x:Name="TopmostItem" Header="Always on top" IsCheckable="True" Click="OnTopmostClick" />
                <MenuItem x:Name="CompactItem" Header="Compact mode" IsCheckable="True" Click="OnCompactClick" />
                <MenuItem x:Name="OpacityMenu" Header="Opacity">
                    <MenuItem Header="100%" Tag="1.0" IsCheckable="True" Click="OnOpacityClick" />
                    <MenuItem Header="90%" Tag="0.9" IsCheckable="True" Click="OnOpacityClick" />
                    <MenuItem Header="80%" Tag="0.8" IsCheckable="True" Click="OnOpacityClick" />
                    <MenuItem Header="70%" Tag="0.7" IsCheckable="True" Click="OnOpacityClick" />
                    <MenuItem Header="60%" Tag="0.6" IsCheckable="True" Click="OnOpacityClick" />
                </MenuItem>
                <MenuItem x:Name="StartupItem" Header="Start with Windows" IsCheckable="True" Click="OnStartupClick" />
                <Separator />
                <MenuItem Header="Exit" Click="OnExitClick" />
            </ContextMenu>
        </Border.ContextMenu>

        <StackPanel>
            <!-- Header -->
            <DockPanel Visibility="{Binding ShowDetails, Converter={StaticResource BoolToVis}}" Margin="0,0,0,2">
                <Button x:Name="MenuButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                        Content="&#xE712;" ToolTip="Options" Click="OnMenuButtonClick" />
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                        Content="&#xE72C;" ToolTip="Refresh" Click="OnRefreshClick" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#D97757" VerticalAlignment="Center" Margin="0,0,7,0" />
                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="White" />
                </StackPanel>
            </DockPanel>

            <!-- Limits -->
            <ItemsControl ItemsSource="{Binding Limits}" Margin="0,0,4,0">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Opacity" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStale}" Value="True">
                                <Setter Property="Opacity" Value="0.5" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,6,0,0" Background="Transparent" ToolTip="{Binding ResetTooltip}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="{Binding Label}" FontSize="12" Foreground="#E0FFFFFF"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <ProgressBar Grid.Column="1" Style="{StaticResource UsageBar}"
                                         Value="{Binding Percent, Mode=OneWay}"
                                         Foreground="{Binding BarBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding PercentText}" FontSize="12"
                                       FontWeight="SemiBold" Foreground="White"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                       Text="{Binding ResetText}" FontSize="10.5" Foreground="#8CFFFFFF"
                                       Margin="0,1,0,0"
                                       Visibility="{Binding DataContext.ShowDetails,
                                                    RelativeSource={RelativeSource AncestorType=Window},
                                                    Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Status -->
            <TextBlock Text="{Binding Status}" FontSize="10.5" Foreground="#73FFFFFF" Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       Visibility="{Binding ShowStatus, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </Border>
</Window>
