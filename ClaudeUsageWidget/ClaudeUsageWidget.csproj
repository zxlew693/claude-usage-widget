<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows 10 SDK target gives access to WinRT APIs (StartupTask for the MSIX build). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ClaudeUsageWidget</RootNamespace>
    <AssemblyName>claude-usage-widget</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
    <Product>Usage Meter for Claude</Product>
    <!-- Shown as the "description" in Task Manager, Startup apps and file Properties. -->
    <AssemblyTitle>Usage Meter for Claude</AssemblyTitle>
    <ApplicationIcon>..\assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\assets\app.ico" Link="Assets\app.ico" />
    <Resource Include="..\assets\logo-256.png" Link="Assets\logo.png" />
  </ItemGroup>

  <!-- Single-file publish: bundle WPF's native DLLs into the exe and compress it. -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
